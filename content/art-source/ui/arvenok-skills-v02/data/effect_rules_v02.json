{
  "schema": "design-reference-v0.2",
  "probabilistic_avoidance": false,
  "hit_resolution_order": [
    "server hit validation",
    "timed dodge",
    "timed parry",
    "timed perfect block",
    "ordinary block or ward mitigation",
    "final hp damage",
    "lifesteal from final eligible damage"
  ],
  "effects": {
    "lifesteal": {
      "direct_damage_only": true,
      "pve_fraction": 0.08,
      "pvp_fraction": 0.05,
      "heal_cap_per_skill_activation_pve_hp": 5,
      "heal_cap_per_skill_activation_pvp_hp": 3,
      "fractional_healing_accumulator": true,
      "excluded": [
        "DOT",
        "environment",
        "reflected",
        "pet",
        "blocked_or_dodged_hit",
        "self_damage"
      ],
      "never_above_max_hp": true
    },
    "dodge": {
      "active_window_s": 0.25,
      "negates": "one direct targeted hit only",
      "does_not_negate": [
        "AoE",
        "environment",
        "ground hazard"
      ],
      "no_random_chance": true
    },
    "parry": {
      "window_s": 0.35,
      "requires": "two_handed_sword",
      "negates": "one incoming frontal direct physical attack",
      "does_not_negate": [
        "magic",
        "AoE",
        "ground hazard"
      ],
      "facing_validated_server_side": true
    },
    "block": {
      "guard_base_reduction": 0.35,
      "shield_guard_physical_reduction": 0.45,
      "shield_guard_magic_reduction": 0.35,
      "shield_mastery_physical_reduction": 0.5,
      "perfect_block_window_s": 0.4,
      "perfect_block_single_frontal_direct_hit": true,
      "never_stacks_multiplicatively_with_other_defenses": true
    }
  }
}
